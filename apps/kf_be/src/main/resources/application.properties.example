spring.application.name=kf

# MySQL settings
spring.datasource.url=${SPRING_DATASOURCE_URL:jdbc:mysql://localhost:3306/korea_fashion?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC}
spring.datasource.username=${SPRING_DATASOURCE_USERNAME:your_username}
spring.datasource.password=${SPRING_DATASOURCE_PASSWORD:your_password}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# Automatically update database schema from JPA entities during development.
spring.jpa.generate-ddl=true
spring.jpa.hibernate.ddl-auto=${SPRING_JPA_HIBERNATE_DDL_AUTO:validate}
spring.jpa.show-sql=${SPRING_JPA_SHOW_SQL:false}
spring.jpa.properties.hibernate.format_sql=${SPRING_JPA_FORMAT_SQL:false}

# JWT settings
app.jwt.secret=${APP_JWT_SECRET}
app.jwt.expiration-ms=86400000

# CORS settings
app.cors.allowed-origins=${APP_CORS_ALLOWED_ORIGINS:http://localhost:3000}
server.forward-headers-strategy=${SERVER_FORWARD_HEADERS_STRATEGY:framework}

# Media files are stored on the VPS filesystem beside the deployed app/docker volume.
kf.media.storage-dir=${KF_MEDIA_STORAGE_DIR:uploads}
kf.media.schema-initializer.enabled=${KF_MEDIA_SCHEMA_INITIALIZER_ENABLED:false}
spring.servlet.multipart.max-file-size=${SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE:100MB}
spring.servlet.multipart.max-request-size=${SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE:120MB}

# Swagger UI groups
springdoc.api-docs.groups.enabled=true
springdoc.swagger-ui.disable-swagger-default-url=true
springdoc.swagger-ui.urls-primary-name=02-admin-private

# Gemini chatbot
gemini.api-key=${GEMINI_API_KEY:}
gemini.model=${GEMINI_MODEL:gemini-3.5-flash}
chatbot.rate-limit.hourly=${CHATBOT_RATE_LIMIT_HOURLY:20}
chatbot.rate-limit.daily=${CHATBOT_RATE_LIMIT_DAILY:80}
